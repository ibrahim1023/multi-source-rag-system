# Core app
APP_ENV=development
LOG_LEVEL=info

# Models
LLM_MODEL=your-llm-model
EMBEDDINGS_MODEL=your-embedding-model

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333

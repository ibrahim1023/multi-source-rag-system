# Core app
METADATA_BACKEND=auto
ALLOWED_ORIGINS=http://localhost:3000

# Retrieval + models
LLM_MODEL=gemini-flash-latest
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=8
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
TOP_K=5
CONTEXT_MAX_CHUNKS=6
NEIGHBOR_WINDOW=1
BM25_PATH=backend/.bm25.json
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_TERMS=24
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=8
FRESHNESS_ENABLED=false
FRESHNESS_WEIGHT=0.15
FRESHNESS_HALF_LIFE_DAYS=30
FRESHNESS_SOURCE_WEIGHTS={"pdf":0.6,"markdown":1.0,"code":0.8}
CITATION_VALIDATION_ENABLED=true
REINDEX_ENABLED=false
REINDEX_INTERVAL_SECONDS=300
REINDEX_MAX_DOCUMENTS=50

# OCR (PDF fallback)
OCR_ENABLED=false
OCR_MIN_WORD_COUNT=10
OCR_LANG=eng

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/multi_rag

# Storage (local or S3-compatible)
STORAGE_BUCKET=multi-rag
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Observability
OBSERVABILITY_MODE=null
OBSERVABILITY_SERVICE_NAME=multi-rag
OBSERVABILITY_STATIC_FIELDS={"env":"dev"}
OTEL_EXPORTER_OTLP_ENDPOINT=

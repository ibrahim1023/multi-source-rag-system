# Core app
APP_ENV=development
LOG_LEVEL=info
METADATA_BACKEND=auto
ALLOWED_ORIGINS=http://localhost:3000

# Models
LLM_MODEL=your-llm-model
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=8
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
TOP_K=5
CONTEXT_MAX_CHUNKS=6
NEIGHBOR_WINDOW=1
BM25_PATH=backend/.bm25.json

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/multi_rag

# Storage (local or S3-compatible)
STORAGE_BUCKET=multi-rag
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
